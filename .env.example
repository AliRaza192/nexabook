# ===========================================
# NexaBook - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ---------- REQUIRED ----------

# Neon PostgreSQL
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# ---------- REQUIRED FOR PRODUCTION ----------

# Upstash Redis (required for rate limiting on Vercel)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# ---------- PAYMENTS ----------

# Stripe (for billing/subscriptions)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# ---------- EMAIL ----------

# Resend (for invoice/quotation emails)
RESEND_API_KEY=re_xxxxx

# ---------- AI CHAT (pick one) ----------

# Google Gemini (recommended)
GEMINI_API_KEY=xxxxx

# OpenAI (fallback)
OPENAI_API_KEY=xxxxx
# OPENAI_MODEL=gpt-4o-mini

# Ollama (local, self-hosted)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ---------- OPTIONAL ----------

# Encryption key for sensitive data (bank tokens, API keys)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=xxxxx

# FBR API (for tax invoice submission)
# FBR_API_URL=https://gw.fbr.gov.pk
# FBR_API_KEY=xxxxx
