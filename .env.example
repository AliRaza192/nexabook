# ===========================================
# NexaBook - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ---------- REQUIRED ----------

# Neon PostgreSQL
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# ---------- REQUIRED FOR PRODUCTION ----------

# Upstash Redis (required for rate limiting on Vercel)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# App URLs (required for redirects, checkout, email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------- PAYMENTS ----------

# Stripe (for billing/subscriptions)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_PROFESSIONAL_PRICE_ID=price_xxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxx

# ---------- LOCAL PAYMENT GATEWAYS ----------

# JazzCash
JAZZCASH_MERCHANT_ID=xxxxx
JAZZCASH_PASSWORD=xxxxx
JAZZCASH_INTEGRITY_SALT=xxxxx
JAZZCASH_RETURN_URL=https://yourapp.com/api/payments/callback
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/1.0/organize/transaction
JAZZCASH_STATUS_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/1.0/organize/status

# Easypaisa
EASYPAISA_ACCOUNT_NUMBER=xxxxx
EASYPAISA_STORE_NAME=YourStoreName
EASYPAISA_API_KEY=xxxxx
EASYPAISA_RETURN_URL=https://yourapp.com/api/payments/callback
EASYPAISA_API_URL=https://sandbox.easypaisa.com.pk/easypaisa-app/api/
EASYPAISA_STATUS_URL=https://sandbox.easypaisa.com.pk/easypaisa-app/api/status

# ---------- EMAIL ----------

# Resend (for invoice/quotation emails)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=invoices@yourdomain.com

# ---------- WHATSAPP ----------

# WhatsApp Business API (for invoice/quotation/reminder messages)
WHATSAPP_PHONE_NUMBER_ID=xxxxx
WHATSAPP_ACCESS_TOKEN=xxxxx

# ---------- AI CHAT (pick one) ----------

# Google Gemini (recommended)
GEMINI_API_KEY=xxxxx

# OpenAI (fallback)
OPENAI_API_KEY=xxxxx
# OPENAI_MODEL=gpt-4o-mini

# Ollama (local, self-hosted)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ---------- CRON SECURITY ----------

# Secret token for Vercel cron job authentication
CRON_SECRET=xxxxx

# ---------- ERROR TRACKING ----------

# Sentry (for error monitoring)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ---------- OPTIONAL ----------

# Encryption key for sensitive data (bank tokens, API keys)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=xxxxx

# FBR API (for tax invoice submission)
# FBR_API_URL=https://gw.fbr.gov.pk
# FBR_API_KEY=xxxxx
# FBR_SANDBOX=true
